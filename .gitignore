# The SQLite file. DB_PATH defaults to this name in the working directory, so a
# plain `go run .` from a clone writes it here. It holds the operator's real
# Bookmarks: never commit it.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Copies of it. The backup recipe in deploy/README.md writes
# ./bookmarks.sqlite.bak beside the compose file, and a dated name is just as
# likely; either holds the same Bookmarks as the original. Matches any suffix
# after ".sqlite", but not the "-journal"/"-wal"/"-shm" sidecars above, which
# use a hyphen.
*.sqlite.*

# The operator's secret. .env.example is the committed template.
.env

# The default bind mount from docker-compose.yml. It holds the SQLite file,
# which the rule above covers, but the directory itself would still show up.
/data/

# Build output.
/bookmarks
/dist/

# Editor and OS noise.
.DS_Store
*.swp
.idea/
.vscode/
