# Copy to .env (docker compose reads .env from this directory) and set a strong
# secret. Auth is on by default, so TOKEN must be non-empty.
#
#   cp .env.example .env
#
# Generate one, e.g.:
#   openssl rand -hex 32
TOKEN=change-me-to-a-long-random-string

# Optional. The public base URL the app builds links with. Leave unset to derive
# it from each request, which is the right default when a reverse proxy passes
# the real Host through. Set it only when the proxy presents a different public
# address than the request Host.
# BASE_URL=https://bookmarks.example.com

# Optional. Uncomment ONLY on a network you fully trust: this disables the
# shared secret entirely, serving every Bookmark to anyone who can reach the
# port. Accepts 1, true, yes, or on.
# AUTH_DISABLED=1
